# ============================================
# WATSONX HACKATHON - ENVIRONMENT VARIABLES
# ============================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env  ->  cp .env.example .env
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to git
# 4. NEVER share your credentials in code or with AI assistants
#
# ============================================

# IBM Cloud API Key
# Get from: https://cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=your_api_key_here_DO_NOT_COMMIT

# ============================================
# MEMO APP - BACKEND
# ============================================

# --- Database ---
# Local SQLite (dev):
DATABASE_URL=sqlite+aiosqlite:///./memo_dev.db
# Production PostgreSQL / Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=memo-app

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173

# --- Session ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ============================================
# MEMO APP - FRONTEND (prefix with VITE_)
# ============================================
VITE_API_URL=http://localhost:8000/api/v1
VITE_GITHUB_APP_SLUG=memo-app

# ============================================
# SECURITY REMINDERS:
# - This .env.example file is safe to commit
# - Your actual .env file is in .gitignore
# - Never hardcode credentials in your code
# - Never share credentials with AI assistants like Bob
# ============================================