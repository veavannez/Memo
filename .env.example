# ============================================================
# MEMO — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/memo
# For Supabase: postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres

# --- Security ---
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"

# --- GitHub App ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
# Or inline (newlines replaced with \n):
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...

GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_SLUG=memo-app
# The name used in GitHub App installation URLs

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173

# --- Session ---
# JWT access token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT refresh token expiry in days
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AI (Post-MVP, optional) ---
# OPENAI_API_KEY=
