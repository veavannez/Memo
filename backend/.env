# ============================================================
# MEMO Backend — Local Development Environment
# Copy from .env.example and fill in real values.
# ============================================================

# --- Database (local SQLite for easy dev, no Postgres needed) ---
DATABASE_URL=sqlite+aiosqlite:///./memo_dev.db

# --- Security (change this!) ---
SECRET_KEY=dev-secret-key-change-in-production-please-use-32-chars-min

# --- GitHub App (fill in after creating your GitHub App) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app.private-key.pem
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=dev-webhook-secret
GITHUB_APP_SLUG=memo-app

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

# --- Token expiry ---
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
